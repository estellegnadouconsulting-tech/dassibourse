pragma solidity ^0.8.20;

contract Compliance {

    address public admin;

    mapping(address => bool) public whitelist;

    constructor() {
        admin = msg.sender;
    }

    modifier onlyAdmin() {
        require(msg.sender == admin, "Not admin");
        _;
    }

    function addInvestor(address investor) public onlyAdmin {
        whitelist[investor] = true;
    }

    function removeInvestor(address investor) public onlyAdmin {
        whitelist[investor] = false;
    }

    function isWhitelisted(address investor) public view returns (bool) {
        return whitelist[investor];
    }
}
